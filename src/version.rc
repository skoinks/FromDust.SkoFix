#include <winver.h>
#include "version.h"
VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_NUMBERS
PRODUCTVERSION VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "skoinks"
            VALUE "FileDescription", "Unofficial fix for From Dust"
            VALUE "FileVersion", VERSION
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "dinput8.dll"
            VALUE "ProductName", "From Dust SkoFix"
            VALUE "ProductVersion", VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
